# Environment mode: development or production
ENVIRONMENT=development

# Database settings (used by Postgres container and API)
POSTGRES_USER=ai_swe_user
POSTGRES_PASSWORD=ai_swe_password
POSTGRES_DB=ai_swe_db

# Security & Session
JWT_SECRET=your_super_secret_jwt_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# GitHub OAuth credentials
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost/api/v1/accounts/auth/github/callback

# Token encryption key for encrypted GitHub tokens at rest
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Frontend URL (for CORS and OAuth redirects)
FRONTEND_URL=http://localhost

# Optional Cloud LLM API Keys
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Ollama local models URL
OLLAMA_BASE_URL=http://host.docker.internal:11434

