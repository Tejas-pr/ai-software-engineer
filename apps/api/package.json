{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "uv run uvicorn app.main:app",
    "dev": "uv run uvicorn app.main:app --reload",
    "lint": "uv run ruff check .",
    "format": "uv run ruff format .",
    "typecheck": "uv run mypy .",
    "test": "uv run pytest",
    "db:generate": "uv run alembic revision --autogenerate",
    "db:migrate": "uv run alembic upgrade head",
    "db:rollback": "uv run alembic downgrade -1",
    "db:status": "uv run alembic current"
  }
}
