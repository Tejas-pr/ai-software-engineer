ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://ai_swe_user:ai_swe_password@localhost:5433/ai_swe_db
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# auth
JWT_SECRET=your_super_secret_jwt_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/accounts/auth/github/callback

TOKEN_ENCRYPTION_KEY=AJfaOxnxZquE1lBW4q

# AI
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODELS=["gemini-3.6-flash", "gemini-2.5-flash", "gemini-2.5-pro", "gemini-1.5-flash", "gemini-1.5-pro"]

# ollama (local dev default — no key needed)
OLLAMA_MODELS=["qwen2.5-coder:7b", "deepseek-r1:8b", "qwen2:7b", "gemma3:4b"]
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CODE_MODEL=qwen2.5-coder:7b
OLLAMA_REASONING_MODEL=deepseek-r1:8b

# anthropic / openai — optional cloud providers for agent runs, leave blank to disable
ANTHROPIC_API_KEY=
ANTHROPIC_MODELS=["claude-sonnet-5", "claude-opus-5", "claude-haiku-4-5-20251001"]
OPENAI_API_KEY=
OPENAI_MODELS=["gpt-5.1", "gpt-5.1-mini"]

# token encryption — used to encrypt the stored GitHub access token at rest.
# generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
